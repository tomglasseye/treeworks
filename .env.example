# Publishable — safe in the browser bundle (VITE_ prefix required)
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2026-08-01
VITE_SANITY_STUDIO_URL=/studio

# Behold — the public JSON feed URL for the Instagram gallery.
# Create at behold.so: connect the Instagram account once, copy the feed URL.
# Public by design; no Meta app and no token refresh on our side.
VITE_BEHOLD_FEED_URL=

# Studio configuration has moved to studio/.env — the Sanity CLI now compiles
# the Studio from that folder and reads env files relative to it. Project and
# dataset have literal fallbacks in studio/sanity.config.ts, so that file is
# optional. See studio/.env.example.
#
# SANITY_STUDIO_BASE_PATH is deliberately NOT set anywhere: the default is
# /studio, which is where the site serves it, and `npm run studio:deploy`
# overrides it to "/" for the Sanity-hosted copy.

# Secrets — server only. Never prefix with VITE_.
# Viewer token, required for Presentation live preview (reads drafts).
# sanity.io/manage -> project -> API -> Tokens -> Add token -> Viewer
SANITY_VIEWER_TOKEN=

# Signs the cookies that grant draft access. Any long random string.
# Required in production — the app refuses to boot without it, because the
# development fallback is published in this repository.
PREVIEW_COOKIE_SECRET=

# Local production preview only (npm run preview). Netlify sets its own port.
PORT=3001
