# The Sanity CLI reads env files from THIS folder, not the repository root, and
# exposes only SANITY_STUDIO_* to the Studio bundle.
#
# Everything here is optional: sanity.config.ts and sanity.cli.ts carry literal
# fallbacks for the project and dataset so a clean checkout — and the Netlify
# build, which has no env file at all — works without this file.

SANITY_STUDIO_PROJECT_ID=bb392mn5
SANITY_STUDIO_DATASET=production

# Only for the Sanity-hosted copy: Presentation needs to be told which origin
# the site is on, because that Studio is not served from it.
# SANITY_STUDIO_PREVIEW_ORIGIN=https://treeworkscornwall.co.uk

# Do NOT set SANITY_STUDIO_BASE_PATH here. The default (/studio) is what the
# site serves; `npm run deploy` overrides it to "/" for the Sanity-hosted copy.
